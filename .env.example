# Copy to .env and fill in. Never commit .env.

# Port the Node process listens on. Nginx proxies to this, so it stays local.
PORT=3000
HOST=127.0.0.1

# Password for the host console. Anyone with this can create and run games.
# Generate one with: openssl rand -base64 24
HOST_PASSWORD=change-me-before-you-deploy

# Secret used to sign the host session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# Public URL players will type or scan. Used for the QR code on the lobby screen.
PUBLIC_URL=https://quiz.example.com

# Where the SQLite file lives. Keep it outside the deploy folder so
# a redeploy never wipes your quiz library or past results.
DB_PATH=/var/lib/floor-quiz/floor-quiz.db

# Hard ceiling on players per game. Raise if you need it, the server
# handles far more than this, the limit is here to catch runaway loops.
MAX_PLAYERS=400

# Set to "production" on the VPS.
NODE_ENV=production
